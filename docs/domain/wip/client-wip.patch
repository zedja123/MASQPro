+static bool IsMainDeckCardMisplaced(const CardDataC* cit, bool rituals_in_extra) {
+	if((cit->type & (TYPE_FUSION | TYPE_SYNCHRO | TYPE_XYZ)) || (cit->type & TYPE_LINK && cit->type & TYPE_MONSTER))
